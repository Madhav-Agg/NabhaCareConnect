# ---------------------------------------------------------------------------
# Backend configuration template. Copy to .env and fill in.
#   cp .env.example .env
#
# Every value below has a safe default except the integration credentials, which
# are optional: the app runs without them and reports honestly when a feature is
# unavailable rather than pretending to work.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Path to the SQLite file. Created automatically, along with its schema.
DB_FILE=./data/nabhacare.sqlite

# --- Authentication ---------------------------------------------------------
# REQUIRED in production. Signs the session JWTs. Rotating it signs everyone out.
# In development, if unset, a random secret is generated and cached in
# data/.jwt-secret so restarts do not drop your session.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- One-time codes ---------------------------------------------------------
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_PEPPER=

# DEVELOPMENT ONLY. When true, the one-time code is returned in the send-otp
# response so you can log in without an SMS gateway. The backend ignores this
# setting entirely when NODE_ENV=production.
DEV_EXPOSE_OTP=true

# Guards scripts/seed-dev.js. The seed refuses to run unless this is true AND
# NODE_ENV is not production.
ALLOW_DEV_SEED=true

# --- Emergency (SOS) -------------------------------------------------------
# Numbers notified when an SOS alert is raised. Comma separated.
# SOS dispatch fails with a clear 503 if this is empty.
SOS_RECIPIENT_NUMBERS=
# Number used by POST /api/patient/call/emergency when none is supplied.
EMERGENCY_CALL_NUMBER=112

# --- Twilio (optional) ------------------------------------------------------
# Without these, OTP codes are logged instead of texted and SOS endpoints return
# 503 rather than reporting a false success.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Email alerts (optional) ------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# ALERT_EMAIL=

# --- AI symptom checker (optional) -----------------------------------------
# Without a key, the symptom checker and home-remedies endpoints return 503
# with a clear message instead of fabricated advice.
OPENROUTER_API_KEY=
# Leave unset to use the built-in fallback chain of free models.
# OPENROUTER_MODEL=
AI_REQUEST_TIMEOUT_MS=45000

# --- CORS -------------------------------------------------------------------
# Browser origins allowed to call this API. Must include the frontend origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000